# Local Supabase public configuration (safe to expose in browser; RLS is mandatory)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Deploy the same app to a separate host-only-cookie origin for the demo.
NEXT_PUBLIC_DEMO_ORIGIN=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only configuration. Never use NEXT_PUBLIC_ for these values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Provision this dedicated least-privilege login with scripts/bootstrap-local-db-role.sh.
OST_WEB_DB_PASSWORD=replace-with-64-random-hex-characters
SUPABASE_DB_URL=postgresql://ost_web_app_login:replace-with-password@127.0.0.1:54342/postgres
SUPABASE_STORAGE_BUCKET=competition-media

# Must be the final custom hostname before production passkeys are registered.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=OST Competition
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000
WEBAUTHN_CHALLENGE_SECRET=replace-with-at-least-32-random-bytes-generated-on-the-server

# Bootstrap-only; use a privileged operator DB URL temporarily, then unset it.
HOST_BOOTSTRAP_DB_URL=

# Media worker execution controls.
MEDIA_WORKER_IMAGE=ost-competition-media-worker:local
MEDIA_TASK_MODE=local
MEDIA_WORKER_URL=http://127.0.0.1:8080
MEDIA_WORKER_LOCAL_TOKEN=replace-with-a-local-only-random-token
MEDIA_WORKER_CALLBACK_SECRET=replace-with-a-random-32-byte-secret
MEDIA_TASK_MAX_ATTEMPTS=5
MEDIA_ALLOWED_STORAGE_ORIGIN=http://127.0.0.1:54321
MEDIA_CALLBACK_ORIGIN=http://localhost:3000
# Local macOS/Colima only: use a host directory shared with Docker.
MEDIA_WORKER_TEMP_DIR=
MEDIA_MAX_UPLOAD_BYTES=524288000
MEDIA_WORKER_TIMEOUT_SECONDS=180
MEDIA_NORMALIZE_LOUDNESS_DEFAULT=false
MEDIA_ORIGINAL_RETENTION_DAYS=30

# Production Cloud Tasks dispatch (leave empty for local MEDIA_TASK_MODE=local).
GCP_PROJECT_ID=
GCP_REGION=
GCP_TASKS_QUEUE=
GCP_ARTIFACT_REPOSITORY=ost-media
GCP_TASKS_CLIENT_EMAIL=
GCP_TASKS_CLIENT_PRIVATE_KEY=
GCP_TASKS_INVOKER_SERVICE_ACCOUNT=
MEDIA_WORKER_RUNTIME_SERVICE_ACCOUNT=

# Optional feedback target, used by the demo end screen only.
NEXT_PUBLIC_FEEDBACK_INSTAGRAM=https://instagram.com/

# Local test/development only. Do not set these in production.
ALLOW_LOCAL_TEST_AUTH=false
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
